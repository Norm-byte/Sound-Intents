rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'super-admin' &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true;
    }
    
    function isActiveAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true;
    }
    
    function isFirstUser() {
      // Allow the first authenticated user to create their super-admin record
      // Only when no admin_users documents exist yet
      return isSignedIn() && 
             !exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.role == 'super-admin';
    }

    function isSuspendedUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.status == 'suspended' &&
             (
               !(get(/databases/$(database)/documents/users/$(userId)).data.suspensionExpiry is timestamp) ||
               get(/databases/$(database)/documents/users/$(userId)).data.suspensionExpiry > request.time
             );
    }

    function canPostCommunity(userId) {
      return isActiveAdmin() ||
             userId == 'admin_host' ||
             (
               isSignedIn() &&
               !isSuspendedUser(request.auth.uid)
             ) ||
             (
               userId is string &&
               userId.size() > 0 &&
               (
                 !exists(/databases/$(database)/documents/users/$(userId)) ||
                 !isSuspendedUser(userId)
               )
             );
    }

    function isLegacyCommunityPostPayload() {
      return request.resource.data.keys().hasAny(['content']) &&
             request.resource.data.keys().hasAny(['userName']);
    }

    function isLegacyCommunityMessagePayload() {
      return request.resource.data.keys().hasAny(['text']) &&
             request.resource.data.keys().hasAny(['sender']);
    }

        function isCommunityReactionOnlyUpdate() {
          let oldLikes =
            (resource.data.keys().hasAny(['likes']) && resource.data.likes is int)
              ? resource.data.likes
              : 0;
          let newLikes = request.resource.data.likes;
          let oldLikedBySize =
            (resource.data.keys().hasAny(['likedBy']) &&
                resource.data.likedBy is list)
              ? resource.data.likedBy.size()
              : 0;
          let newLikedBySize =
            request.resource.data.likedBy is list
              ? request.resource.data.likedBy.size()
              : -999;

          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'likes',
               'likedBy',
             ]) &&
             newLikes is int &&
             request.resource.data.likedBy is list &&
             (newLikes == oldLikes + 1 || newLikes == oldLikes - 1) &&
             (newLikedBySize == oldLikedBySize + 1 ||
              newLikedBySize == oldLikedBySize - 1);
        }
    
    // Admin users collection - only admins can read, only super-admins can write
    match /admin_users/{userId} {
      // Allow read if:
      // 1. You're an active admin reading any admin record, OR
      // 2. You're the first user checking if admins exist (via hasAnyAdmins)
      allow read: if isActiveAdmin() || isSignedIn();
      
      // Allow create if:
      // 1. You're a super-admin creating new admins, OR
      // 2. You're the first user creating the initial super-admin record
      allow create: if isSuperAdmin() || 
                       (isSignedIn() && 
                        userId == request.auth.uid && 
                        request.resource.data.role == 'super-admin' &&
                        !existsAfter(/databases/$(database)/documents/admin_users/__check__));
      
      // Allow update/delete only for super-admins.
      // Exception: user can only update their own session heartbeat timestamps.
      allow update: if isSuperAdmin() ||
                       (isSignedIn() &&
                        request.auth.uid == userId &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'lastLogin',
                          'lastActive'
                        ]));
      
      allow delete: if isSuperAdmin();
    }

    // Admin Locks - Traffic Control
    match /admin_locks/{lockId} {
      allow read, write: if isActiveAdmin();
    }

    // Admin Presence - Who is online
    match /admin_presence/{userId} {
      allow read, write: if true; // Fully open for dashboard functionality
    }

    // Support Inbox - Central Alert System
    match /support_inbox/{document=**} {
      allow read, write: if true; // Write: Users send alerts. Read: Admins view inbox. 
    }

    // Moderation Queue - User reports and admin actions
    match /moderation_queue/{reportId} {
      allow create: if true;
      allow read: if isActiveAdmin();
      allow update, delete: if isActiveAdmin();
    }
    
    // Admin access requests - users can create their own, super-admins can read/update all
    match /admin_access_requests/{requestId} {
      // Anyone authenticated can read their own request
      allow read: if isSignedIn() && 
                     (requestId == request.auth.uid || isSuperAdmin());
      
      // Users can create their own access request
      allow create: if isSignedIn() && 
                       requestId == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid;
      
      // Only super-admins can update/delete requests (for approval/rejection)
      allow update, delete: if isSuperAdmin();
    }
    
    // Events collection - Public read, Admin write
    match /events/{eventId} {
      function validOnPublish() {
        return request.resource.data.isPublished == false || (
          request.resource.data.keys().hasAny(['title']) &&
          request.resource.data.title is string && request.resource.data.title.size() > 0 &&
          request.resource.data.startTimeUTC is string && request.resource.data.startTimeUTC.size() > 0 &&
          request.resource.data.isDraft == false
        );
      }

      allow read: if true; // Changed to allow public access for the User App
      allow create, update: if true; // Temporarily allowed for development/testing
      allow delete: if isActiveAdmin();

      match /playback_devices/{deviceId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isActiveAdmin();
      }
    }

    // Global Events (for Event Creator) - Public read, Admin write
    match /global_events/{eventId} {
      allow read: if true; // Changed to allow public access for the User App
      allow write: if isActiveAdmin();

      match /playback_devices/{deviceId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isActiveAdmin();
      }
    }
    
    // Media collection - only active admins can read/write
    match /media_library/{mediaId} {
      allow read, write: if true;
    }

    // Media Settings (for sections list)
    match /media_settings/{docId} {
      allow read, write: if true;
    }

    // Community Groups (for Chat/Group Management)
    match /community_groups/{groupId} {
      allow read: if true; // Public read needed so users can see groups
      allow write: if isActiveAdmin(); // Admins create/update groups
      
      // Allow public access to messages within community groups
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Media Sections - only active admins can read/write
    match /media_sections/{sectionId} {
      allow read, write: if true;
    }

    // YouTube Library - only active admins can read/write
    match /youtube_library/{videoId} {
      allow read, write: if true;
    }

    // YouTube Library Drafts - only active admins can read/write
    match /youtube_library_draft/{videoId} {
      allow read, write: if isActiveAdmin();
    }

    // YouTube Sections - Public read, Admin write (Updated for User App)
    match /youtube_sections/{sectionId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // YouTube Sections Drafts - only active admins can read/write
    match /youtube_sections_draft/{sectionId} {
      allow read, write: if isActiveAdmin();
    }

    // Global Settings (Maintenance Mode, etc.) - user app reads 'settings/global'
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // System Settings - Public read (for feature flags), Admin write
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // VIP Codes
    match /vip_codes/{codeId} {
      // TEMPORARY: Allow all access for debugging
      allow read, write: if true;
    }

    // Community Posts - Public read, Authenticated write
    match /community_posts/{postId} {
      allow read: if true;
      // Suspension enforcement deferred to next app update; keep create open.
      allow create: if true;
      allow update, delete: if isActiveAdmin() ||
                            (isSignedIn() && request.auth.uid == resource.data.userId) ||
                            isCommunityReactionOnlyUpdate();

      // Replies under each community post
      match /replies/{replyId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isActiveAdmin() ||
                              (isSignedIn() && request.auth.uid == resource.data.userId) ||
                              isCommunityReactionOnlyUpdate();
      }
    }

    // App Configuration (Dynamic Content)
    match /app_config/{docId} {
      allow read: if true; // User App needs to read this
      // Keep admin writes strict, but allow signed-in admins with missing
      // admin_users bootstrap records to update community settings.
      allow write: if isActiveAdmin() ||
                      (docId == 'community_settings' && isSignedIn());
    }

    // Users collection
    match /users/{userId} {
      // TEMPORARY: Allow public access because User App does not use Firebase Auth yet.
      // TODO: Implement Firebase Auth in User App and restrict this to owner only.
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /favorites/{favoriteId} {
        allow read, write: if true;
      }

      match /registered_events/{eventId} {
        allow read, write: if true;
      }

      match /joined_groups/{groupId} {
        allow read, write: if true;
      }
    }

    // Username reservations (race-proof uniqueness)
    match /usernames/{usernameId} {
      allow read: if true;

      // Create reservation only for the signed-in owner, keyed by lowercase username doc id.
      allow create: if isSignedIn() &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.usernameLower == usernameId;

      // Allow owner to refresh/update their reservation, but not transfer ownership.
      allow update: if isSignedIn() &&
                       resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       request.resource.data.usernameLower == resource.data.usernameLower;

      allow delete: if isSuperAdmin();
    }

    // Collection Group Query for Messages (Support Inbox)
    match /{path=**}/messages/{messageId} {
      allow read: if isActiveAdmin();
    }

    // Product Tiers (Monetization Offers)
    match /product_tiers/{tierId} {
      allow read: if true; // User app needs to see offers (e.g. for paywall)
      allow write: if isActiveAdmin();
    }

    // Product Tiers Drafts (Admin Workspace)
    match /product_tiers_draft/{tierId} {
      allow read, write: if isActiveAdmin();
    }

    // Live Event Viewer Sessions (true real-time overlay stats)
    match /event_live_viewers/{eventId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isActiveAdmin();

      match /sessions/{sessionUserId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // Shared slot-level live viewer sessions used for cross-device aggregation.
    match /event_live_viewers_groups/{groupKey} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isActiveAdmin();

      match /sessions/{sessionUserId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // Live room presence sessions for Community and Chat Rooms overlays
    match /room_live_presence/{roomId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isActiveAdmin();

      match /sessions/{sessionUserId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
